# Copiar a .env (NO subir .env a git)
POSTGRES_PASSWORD=interviewai
DATABASE_URL=postgresql+psycopg://interviewai:interviewai@db:5432/interviewai

# --- LLM: recomendado OLLAMA (local, sin API key) ---
LLM_PROVIDER=ollama      # ollama | fake | gemini (pendiente) | openai (pendiente)
LLM_MODEL=qwen2.5:7b     # debe aparecer en `ollama list`; tambien se puede elegir en la interfaz
OLLAMA_BASE_URL=http://localhost:11434   # con docker compose: http://host.docker.internal:11434

# Solo si algun dia usas proveedores en la nube (pega aqui, NUNCA en el chat ni en git):
GEMINI_API_KEY=
OPENAI_API_KEY=

AUTH_MODE=dev            # SOLO desarrollo (cabecera X-Role)
